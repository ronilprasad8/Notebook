rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/notebooks/{notebookId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      match /sources/{sourceId} {
        function owner() {
          return request.auth != null && request.auth.uid == userId;
        }
        allow read, delete: if owner();
        allow create: if owner()
          && exists(/databases/$(database)/documents/users/$(userId)/notebooks/$(notebookId))
          && request.resource.data.keys().hasOnly(['title', 'text', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200000
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
